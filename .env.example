# Qwen API access (Model Studio / DashScope, Intl-Singapore) — copy to
# .env.local and fill. Never commit .env.local.
DASHSCOPE_API_KEY=

# Model IDs (docs/decisions.md: chained primary, realtime demoted)
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_OMNI_HTTP_MODEL=qwen3.5-omni-plus
QWEN_CHAT_MODEL=qwen3.6-flash
# Vision model used by image descriptions through compatible chat completions.
QWEN_VISION_MODEL=qwen3-vl-flash
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash

# Base URL overrides — leave blank to use the documented Alibaba Cloud Model
# Studio (Intl/Singapore) endpoints. Only set these if your account is
# provisioned on a dedicated/personal MaaS gateway instead (docs/trd.md §2;
# spikes/qwen-probe). QWEN_BASE_URL is the HTTP root (chat + TTS/ASR/vision
# paths are appended); QWEN_WS_HOST is the bare host used for the realtime
# WebSocket session.
QWEN_BASE_URL=
QWEN_WS_HOST=

# Optional phone-hotspot provisioning for scripts/setup-pi.sh. Keep real values
# in .env.local only; SAHURHUB_STATIC_IP accepts ADDRESS/PREFIX (for example
# 192.168.43.10/24) and is omitted to use DHCP.
SAHURHUB_WIFI_SSID=
SAHURHUB_WIFI_PASS=
SAHURHUB_STATIC_IP=
