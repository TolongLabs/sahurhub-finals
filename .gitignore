# https://github.com/github/gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# JS / Bun
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
.next/

# Env / secrets
.env
.env.local
.env.*.local

# Local research scratch (intermediate workflow files; deliverables live in docs/)
_research/

# Local tooling scratch (playwright runs, generated images)
tmp/
output/

# mkcert cert for the phone HTTPS listener (regenerated by scripts/setup.sh)
cert/

# bun:sqlite runtime data
*.sqlite
*.sqlite-journal

# OS / editor
.DS_Store
__MACOSX/
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace

# graphify: commit only the queryable graph + report; ignore regenerable churn
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
